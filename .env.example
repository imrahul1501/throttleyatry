# Environment Configuration Example

# This file should be renamed to .env and placed on your server
# It contains configuration for the Docker deployment

# Application Environment
ENVIRONMENT=production
NODE_ENV=production

# Web Server Configuration
PORT=80
ENABLE_HTTPS=false

# Optional: SSL/TLS Configuration (when ENABLE_HTTPS=true)
# SSL_CERT=/etc/nginx/ssl/cert.pem
# SSL_KEY=/etc/nginx/ssl/key.pem

# Docker Configuration
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/throtalyatry-deploy.log

# Health Check
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/home/throtalyatry/backups

# Notification (Slack)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_NOTIFICATIONS_ENABLED=true

# GitHub Configuration
GITHUB_REPO=https://github.com/YOUR_USERNAME/Throttle-Yatry-main.git
GITHUB_BRANCH=main

# Server Configuration
SERVER_USER=throtalyatry
APP_DIR=/home/throtalyatry/app

# Performance Tuning
NGINX_WORKER_CONNECTIONS=1024
GZIP_ENABLED=true
CACHE_MAX_AGE=86400

# Security
ENABLE_SECURITY_HEADERS=true
ENABLE_CORS=false

# Monitoring
ENABLE_METRICS=false
METRICS_PORT=9090
